; action_params.inc — アクションの調整値（スカラー）。**手触りのノブはここに集約する。**
;
; このファイルと action_params.s（表）以外に、フレーム数・距離・威力・猶予の長さを
; 書いてはならない（.claude/agents/action-dev.md の規約）。
; 主はこの2ファイルの数値を触るだけで手触りを変えられること。
;
;   action_params.inc … 単一の値（フレーム数・速度・しきい値）と、値を導く比
;   action_params.s   … 段数ごと・体格ごとの**表**（攻撃矩形／やられ矩形／HP／猶予／姿勢）
;
; 猶予の長さ（ACT_GRACE_*）は ADR-0005 により「データ側に持つ」もので、
; いまはここにあるが、後で data/action_params.tsv から act_grace_frames 表へ
; 流し込む前提の形にしてある（表の中身が差し替わるだけで済む）。
.ifndef ACTION_PARAMS_INC
ACTION_PARAMS_INC = 1

.include "constants.inc"      ; SPRITE_H（絵の縦サイズ）と SPR_POSE_* を使う

; ==========================================================================
; 1. 奥行き —— レーン廃止後の当たり判定と移動（ADR-0009）
; ==========================================================================
; レーン（4段階の量子化）は ADR-0009 で廃止した。奥行きは連続であり、
; その実体は足元Y（ent_y）そのものである。レーン番号という概念は無い。
; ノブは2つだけ: **奥行きの移動速度**と**当たり判定のY許容幅**。
;
; --------------------------------------------------------------------------
; 1-a. 奥行きの移動速度（ADR-0009 残る論点 1-b。主の調整対象）
; --------------------------------------------------------------------------
; 単位は横移動（ACT_MOVE_SPEED）と同じ 1/16 ドット/フレーム。
; 16 = 1.0 ドット/f で、横（24 = 1.5 ドット/f）の 2/3 である。
;
; 2/3 にした理由:
;   * ベルトスクロールの慣習では、奥行きは横より遅い。奥行きは画面上で圧縮されて
;     見える方向なので、同じドット数でも「速く」感じる。
;   * ただし **遅くしすぎると P1 の苦情（縦だけ制限がある）に戻る。**
;     歩ける帯は 64 ドット（constants.inc の既定）なので、1.0 ドット/f なら
;     帯の端から端まで 64 フレーム（約1.07秒）。読み合いの時間としては十分短い。
;   * **押したフレームに押したぶんだけ動く**（補間なし）ので、遅くても「効かない」
;     感じにはならない。ここが旧レーンとの決定的な違いである。
; 上げ下げの目安: 24 にすると縦横が完全に同速になる（奥行きが速く感じる）。
;                 8 にすると 0.5 ドット/f で、帯の横断に 128 フレームかかる（遅すぎ）。
ACT_DEPTH_SPEED       = 16

; --------------------------------------------------------------------------
; 1-b. 当たり判定のY許容幅（ADR-0009 残る論点 1-a。**主が決定済み**）
; --------------------------------------------------------------------------
; 攻撃側と被弾側の足元Yの差が、この幅以内なら「奥行きが合っている」とみなす。
; depth_distance（engine）が返す |足元Yの差| と比べる。
;
; **重要: 数値ではなく比が本体である。**
; 主の決定は「キャラクターの縦サイズの 1/3（16 ドットのキャラなら 5〜6 ドット）」であり、
; **絵が大きくなれば許容幅も比例して動くべき量**である（ADR-0009 §残る論点 1-a）。
; 固定の数値として埋めると、絵を大きくしたときに置き去りになり、
; 「大きいキャラほど当たらない」という P1 と同種の理不尽を生む。
;
; そこで、許容幅は**体格型ごとの絵の縦サイズから計算して**表にする（action_params.s の
; act_depth_tol）。縦サイズは 8x16 スプライト何段ぶんの絵かで表す。
; 絵を 2x3 タイル（16x24 ドット）などに拡大するときは、
; **下の ACT_BODY_ROWS_* を直すだけでよい。許容幅は自動で追随する。**
;
; 比を変えたいときは NUM / DEN を触る（1/3 → 1/2 なら当たりやすくなる）。
ACT_DEPTH_TOL_NUM     = 1
ACT_DEPTH_TOL_DEN     = 3

; 体格型（BODY_*）ごとの絵の縦サイズ。8x16 スプライト何段ぶんか。
; いまは仮CHR がどの体格も 8x16 一段なので全部 1 である
; （engine の body_width が持つのは**横**のタイル数で、縦は今のところ全て1段）。
ACT_BODY_ROWS_PLACEHOLDER = 1
ACT_BODY_ROWS_LIGHT       = 1
ACT_BODY_ROWS_HEAVY       = 1
ACT_BODY_ROWS_BEAST       = 1
ACT_BODY_ROWS_BEAST_LARGE = 1
ACT_BODY_ROWS_MACHINE     = 1

; 段数 → 絵の縦ドット数 → 許容幅。8x16 一段なら 16 * 1 / 3 = 5 ドット（主の決定の範囲内）。
; **この6行は手で数値に書き換えないこと。**上の ACT_BODY_ROWS_* と比から計算される式で
; あることが ADR-0009 の要求（縦サイズを変えたら許容幅が追随する）そのものである。
ACT_DEPTH_TOL_PLACEHOLDER = ACT_BODY_ROWS_PLACEHOLDER * SPRITE_H * ACT_DEPTH_TOL_NUM / ACT_DEPTH_TOL_DEN
ACT_DEPTH_TOL_LIGHT       = ACT_BODY_ROWS_LIGHT       * SPRITE_H * ACT_DEPTH_TOL_NUM / ACT_DEPTH_TOL_DEN
ACT_DEPTH_TOL_HEAVY       = ACT_BODY_ROWS_HEAVY       * SPRITE_H * ACT_DEPTH_TOL_NUM / ACT_DEPTH_TOL_DEN
ACT_DEPTH_TOL_BEAST       = ACT_BODY_ROWS_BEAST       * SPRITE_H * ACT_DEPTH_TOL_NUM / ACT_DEPTH_TOL_DEN
ACT_DEPTH_TOL_BEAST_LARGE = ACT_BODY_ROWS_BEAST_LARGE * SPRITE_H * ACT_DEPTH_TOL_NUM / ACT_DEPTH_TOL_DEN
ACT_DEPTH_TOL_MACHINE     = ACT_BODY_ROWS_MACHINE     * SPRITE_H * ACT_DEPTH_TOL_NUM / ACT_DEPTH_TOL_DEN

; 攻撃側と被弾側で体格が違うとき、どちらの許容幅を使うか。
;   0 = 両者の平均（既定）。大きい相手には広く、小さい相手には狭くなる
;   1 = 被弾側だけで決める（攻撃側の体格を見ない）
; 平均を既定にしたのは、「大きいキャラほど当たらない」も
; 「大きいキャラだけ当たりやすい」も避けるためである。
ACT_DEPTH_TOL_PAIR    = 0

; ==========================================================================
; 2. 移動
; ==========================================================================
ACT_MOVE_SPEED        = 24    ; 横移動の速さ。1/16 ドット/フレーム（24 = 1.5 ドット/f）
ACT_EDGE_MARGIN       = 16    ; ステージ右端に残す余白（体1つぶん）。左端は常に 0

; ==========================================================================
; 3. 攻撃とコンボ
; ==========================================================================
ACT_COMBO_MAX         = 3     ; コンボの段数（2〜3段まで。表の項数と一致させること）
ACT_BUF_FRAMES        = 12    ; 先行入力の寿命（フレーム）。長いほど繋がりやすく暴発もしやすい
                              ; ヒットストップ中もこのバッファは捨てない（規約）。
                              ; ただし猶予中（ダウン中）だけは例外で捨てる（ADR-0006）
; 段をつなぐ受付時間は「その段の atk_recover」そのものである（action_params.s）。
; 繋げやすくしたければ atk_recover を延ばすか ACT_BUF_FRAMES を増やす。

; ==========================================================================
; 4. 手応え（ヒットストップ・ノックバック・無敵）
; ==========================================================================
ACT_HITSTOP_FRAMES    = 6     ; 命中時に攻撃側・被弾側の更新を止めるフレーム数
ACT_HURT_FRAMES       = 14    ; のけぞり（被弾硬直）のフレーム数
ACT_INVULN_FRAMES     = 30    ; 被弾後に再被弾しないフレーム数（点滅もこの間）
ACT_KB_DECAY          = 1     ; ノックバック速度の1フレームあたりの減衰（ドット/f）
                              ; 距離 = 速度の総和。速度 v・減衰 d なら およそ v*(v/d+1)/2 ドット
                              ; 初速は段ごと（action_params.s の atk_kb）

; ==========================================================================
; 5. 体力とダウン（猶予中）—— ADR-0005 / ADR-0006
; ==========================================================================
ACT_HP_PARTY          = 16    ; 操作キャラ・仲間の初期HP（P4 で roster データに置き換わる仮値）
ACT_REVIVE_HP         = 8     ; 蘇生（ダウンからの復帰）で戻るHP
ACT_REVIVE_INVULN     = 60    ; 復帰直後の無敵フレーム数（起き攻めで即再ダウンしないため）

; 猶予（ダウンしてから、シナリオ失敗／戦線離脱が確定するまで）の長さ。フレーム数。
; **8bit のタイマーなので上限は 255（約4.2秒）。** それ以上にしたくなったら
; act_timer を16bit にする必要がある（報告事項）。
ACT_GRACE_PLAYER      = 180   ; 操作キャラ（切れると シナリオ失敗。演出と再開は P4 campaign-dev）
ACT_GRACE_ALLY        = 180   ; 自律仲間（切れると 戦線離脱）
ACT_GRACE_ENEMY       = 20    ; 敵（猶予という概念ではなく「倒れてから消えるまで」）
ACT_DOWN_WARN         = 60    ; 猶予の残りがこれを下回ると点滅が速くなる（残り時間の提示）

; ==========================================================================
; 6. 提示 —— 「いま何が起きているか」を画面に出す
; ==========================================================================
; P1 の受入で主が指摘した「攻撃とダメージ硬直の違いがわからない」「攻撃の距離感が掴めない」
; への対応は、**姿勢（絵）と効果スプライト**である。色の差し替えはその補助にすぎない。
;
; --------------------------------------------------------------------------
; 6-a. 姿勢（どの状態でどの絵を出すか）
; --------------------------------------------------------------------------
; 状態 → 姿勢の割り当て表は action_params.s の act_pose_by_state にある。
; ここにあるのは、表だけでは決まらない2つ（歩きの見分けと、その周期）。
ACT_POSE_MOVE         = SPR_POSE_WALK   ; 待機状態で動いているフレームの姿勢
; 歩きは1枚しか絵が無いので、立ちと交互に出して2コマの歩行にする。
; frame_counter との AND が 0 のフレームだけ立ちに戻る（%00000100 なら 4f ごと）。
; **0 にすると常に立ちのまま**になるので、止めたいときは ACT_POSE_MOVE を
; SPR_POSE_STAND にすること。
ACT_WALK_ANIM         = %00000100

; --------------------------------------------------------------------------
; 6-b. 効果スプライト（攻撃の届く範囲と、当たった位置）
; --------------------------------------------------------------------------
; 「攻撃の距離感が掴めない」の直接の対策である。**当たり判定を画面に出す。**
ACT_SHOW_SWIPE        = 1     ; 1 = 攻撃の持続中、判定矩形の中心に斬りを出す
ACT_SHOW_IMPACT       = 1     ; 1 = 命中した瞬間、相手の位置に衝撃を出す
ACT_FX_IMPACT_LIFE    = 8     ; 衝撃の寿命（フレーム）。ヒットストップ(6)より少し長くする
                              ; 斬りの寿命は「その段の持続フレーム数」そのもの（atk_active）

; --------------------------------------------------------------------------
; 6-c. 色（ADR-0006 の「今は何をしても動かない」の提示）
; --------------------------------------------------------------------------
; 点滅は「本来の色 ⇄ ACT_PAL_BLINK」の間で行う。**他の役割の色を借りない。**
; 借りると、ダウンした操作キャラが敵の色になるなど、意味の衝突が起きる。
;
; パレット3（SPR_PAL_EFFECT）は影と効果が使う。engine-dev が影のために色2 を
; $26（明赤）→ $0F（黒）に変えた。操作キャラのパレット0（$0F/$16/$27/$30）から
; パレット3（$0F/$06/$0F/$30）へ差し替えると、中間色が黒に沈み、輪郭と明部だけが残る。
; **この見え方は点滅として妥当なので、そのまま採用する**（明赤より、黒に沈む方が
; 「一時的に無効になっている」ことが伝わる）。変えたければここを 1 か 2 にすればよい。
ACT_PAL_BLINK         = 3     ; 点滅で沈む側の色（無敵中・ダウン中で共用）
ACT_PAL_OUT           = 3     ; 猶予切れ（もう終わった）。点滅せず沈んだまま
ACT_PAL_ACTIVE        = 2     ; 攻撃判定が出ている間の色
ACT_BLINK_SLOW        = %00001000   ; 猶予に余裕があるときの点滅周期（frame_counter との AND。16f周期）
ACT_BLINK_FAST        = %00000010   ; 猶予が残り少ないときの点滅周期（4f周期）
ACT_BLINK_HURT        = %00000010   ; 無敵中の点滅周期
; 攻撃判定が出ているフレームを色でも示すか。**既定は 0（切）**。
; 姿勢（斬り）と斬りの効果スプライトで判定の出所が見えるようになったので、
; ここまで色を動かすと画面が騒がしく、のけぞりの点滅とも紛れる。
; 判定フレームだけを厳密に見たいときは 1 にする。
ACT_SHOW_ACTIVE       = 0

; ==========================================================================
; 7. P1 の確認用フック —— **仕様ではない。P2 で 0 にする**
; ==========================================================================
; 敵に AI が無く、P1 では蘇生アイテムも載せない（docs/plan.md P1）ため、
; 被弾とダウンを主が画面で確認する手段がこれしかない。
; ADR-0006 が禁じているのは「猶予中のキャラクター操作」であり、
; 猶予に入る前の自傷はそれに当たらない（猶予中は SELECT も効かない）。
ACT_DBG_SELF_DAMAGE   = 1     ; 1 = SELECT で操作キャラが自分にダメージを受ける
ACT_DBG_SELF_DMG      = 4     ; その1回ぶんのダメージ量（HP 16 なら4回でダウン）
ACT_DBG_SELF_KB       = 3     ; そのときのノックバック初速

; 猶予の残りがこの値になった瞬間に自動で復帰する。**0 で無効（既定）。**
; 既定 0 は「P1 の猶予は必ず切れる前提でよい」（docs/plan.md P1）に合わせたもの。
; 蘇生を起動するのは P2 の ai-dev（蘇生アイテム。ADR-0007）であり、ここは
; 「復帰の口（action_revive）が正しく動くか」を主が確認するための仮の引き金である。
; 45 などにすると、猶予 → 自動復帰 → 先行入力が暴発しないこと が1回で確認できる。
ACT_DBG_AUTO_REVIVE   = 0

.endif
