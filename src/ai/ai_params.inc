; ai_params.inc — 自律行動の調整値のうち、**型に属さないもの**。
;
; 型ごとに違う値は data/ai_params.tsv（正本）→ ai_params.s の表にある。
; ここに置いてよいのは「どの型でも同じ、場の規則」だけである。
; 型によって変えたくなった値をここに書いてはならない。TSV に列を足すこと。
.ifndef AI_PARAMS_INC
AI_PARAMS_INC = 1

.include "constants.inc"

; ==========================================================================
; 1. 操作キャラの専有距離 —— **最優先の不具合を潰すための値**
; ==========================================================================
; 自律仲間の最大の失敗は「壁になって進行不能にする」ことである
; （.claude/agents/ai-dev.md の成功条件2）。
; いまのエンジンには実体どうしの押し合いが無いので、仲間が物理的に道を塞ぐことは
; 起きない。塞ぐのは**画面**である: 同じ位置に重なると、操作キャラが
; 仲間の陰に隠れ、1スキャンライン8スプライトの制約でちらつきも増える。
;
; そこで、**絵が縦に重なる奥行きに居る**仲間の**立ち位置そのもの**を、操作キャラから
; この距離だけ外へ押し出す（src/ai/ai.s の ai_clear_player_zone）。
; どんな型でも・どんな目標でも効く「場の規則」である。
;
; 「近づきすぎたら退く」という別行動にしなかったのは、それだと
;   退く → 目標の立ち位置へ戻る → また近づきすぎる
; を毎フレーム繰り返して仲間がその場で震えるからである（実測で 8ドット幅の振動）。
;
; 専有距離は**誰でも同じ**である。以前は仲間の番号ごとに広げていたが、それは
; 「2人とも同時に押し出されたとき」しか効かなかった。押し出された者の行き先は、
; 押し出されなかった者がそこに立っているかどうかを知らないからである
; （実測: 押された仲間2の行き先が、素通りした仲間1の居場所とほぼ一致して 70 フレーム重なった）。
; 仲間どうしの間隔は AI_SPREAD と ai.s の ai_avoid_allies が一手に引き受ける。
AI_CLEAR_X      = 14   ; 操作キャラの左右このドット数には立たない（体幅は 8〜32）

; ==========================================================================
; 1-b. 絵が縦に重なる奥行きの幅
; ==========================================================================
; 足元Yがこのドット数より近い2人は、**画面で縦に重なる**（＝互いの陰に入りうる）。
; 専有距離（上）と仲間どうしの最小間隔（下）は、この幅の内側でだけ効かせる。
; レーン時代の「同じレーンか」に当たる判定であり、ADR-0009 でここに置き換わった。
;
; **これは当たり判定の Y許容幅ではない。**当たるかどうかは action の持ち分であり
; （ADR-0009 §帰結）、AI はその値を知らない。ここにあるのは「絵が重なるか」であって
; 「攻撃が届くか」ではない。**混ぜるな。**値が近くなっても意味が違う。
;
; 絵の縦サイズそのものである。8x16 のスプライトは足元Yが 16 ドット未満しか
; 違わなければ、必ず同じ走査線を共有する。体格が縦に伸びたらこの値も伸びる
; （AI_SPREAD が体の幅に対して持っているのと同じ関係）。
AI_OVERLAP_Y    = SPRITE_H   ; ドット

; ==========================================================================
; 2. 団子にならないための分散
; ==========================================================================
; 同じ標的に同じ側から寄る者どうしは、立ち位置をこの幅ずつずらす（ai.s の ai_spread）。
; 同じ値を「仲間どうしの立ち位置の最小間隔」としても使う（ai.s の ai_avoid_allies）。
; どちらも意味は1つ、**絵が重ならない幅**なので、ノブを2つに割らない。
; 順位はエンティティ番号順（乱数を使わない。再現しない不具合を作らないため）。
; 体格型によっては見た目の幅が 32 ドットある（BODY_BEAST_LARGE / BODY_MACHINE）。
; 幅より狭くすると絵が重なる。体格ごとに変えたくなったら TSV に列を足すこと。
AI_SPREAD      = 24    ; 1人ずつ後ろにずれる幅／仲間どうしの最小間隔（ドット）

; ==========================================================================
; 3. 標的選び
; ==========================================================================
; 標的の「遠さ」は 横距離 + 足元Yの差 で測る。**どちらもドットなので重みは要らない。**
; レーン時代は「レーン差 × AI_LANE_COST(8)」という値段を付けていた。レーン番号の差が
; 0..3 しか無く、素のままでは横距離に埋もれたからである。奥行きが連続になった
; （ADR-0009）以上、奥行きの隔たりは最初からドットで出ている。
; **ここで 8 倍すると横距離を食い潰す**（帯の高さぶん＝数十ドットまで出るため、
; 8 倍すれば数百ドット相当になり、攻撃性 aggr_x が横方向にまったく効かなくなる）。
; したがって **AI_LANE_COST は廃止した。倍率のノブを復活させないこと。**

; ==========================================================================
; 4. 立ち位置の許容誤差
; ==========================================================================
; 目標の立ち位置にこの距離まで近づいたら、もう動かない。
; 0 にすると 1/16 ドットの端数で毎フレーム左右に震える。
AI_DEADBAND    = 4     ; ドット（横）

; 奥行きも同じ理由で不感帯が要る（ADR-0009 で連続になったため、横と同じ性質になった）。
; 横より狭いのは、奥行きの隔たりが「攻撃を振るかどうか」の入口でもあるからである
; （ai.s の ai_try_attack）。広く取るほど、合わせ切ったつもりで空振りしうる位置で振る。
; 一方 0 では、標的が毎フレーム動くたびに合わせ直しが走り、足元Yが1ドット刻みで震える
; （足元Yは影の位置でもあるので、震えは影のちらつきとして直に見える）。
; 2 ドットは「8x16 の絵では見えない」かつ「Y許容幅（体格の縦サイズの約1/3。ADR-0009 1-a）より
; 確実に狭い」を両方満たす最小の幅である。**許容幅そのものをここに書いてはならない。**
AI_DEADBAND_Y  = 2     ; ドット（奥行き）

; ==========================================================================
; 5. 思考の分散実行 —— 1フレームの予算
; ==========================================================================
; 毎フレーム全員ぶんの思考を回さない（ai-dev の規約）。
; 重い方（状況評価・標的選び・立ち位置の決定）は1フレームに AI_THINK_PER_FRAME 体だけ、
; 軽い方（決まった立ち位置へ歩く・振る）は毎フレーム全員ぶん行う。
;
; 自律枠は ENT_ALLY_FIRST..ENT_FREE_FIRST-1 の 8 体（仲間2＋敵6）なので、
; 1 なら 1 体あたり 8 フレーム（約0.13秒）に1回考え直す。
; 攻撃に移るかどうかは毎フレーム見ているので、これで反応が鈍ることはない。
; 増やすと反応が良くなり、1フレームの費用が線形に増える。
AI_THINK_PER_FRAME = 1

; 標的が倒れた者は、思考の順番を待たずにその場で考え直す（ai.s の @retarget）。
; まとめて倒した次のフレームだけ全員が考え直すことになるので、そこにも予算を置く。
; あぶれた者は1フレーム何もしない。**1フレームの費用の山はこの値で決まる。**
AI_RETHINK_PER_FRAME = 1

.assert AI_CLEAR_X > 0, error, "専有距離が 0 だと仲間が操作キャラに重なる"
.assert AI_DEADBAND > 0, error, "許容誤差が 0 だと立ち位置で震える"
.assert AI_DEADBAND_Y > 0, error, "奥行きの許容誤差が 0 だと足元Yが毎フレーム震える"
.assert AI_OVERLAP_Y > AI_DEADBAND_Y, error, "重なり幅が不感帯以下だと、重なったまま分散が効かない"
.assert AI_THINK_PER_FRAME >= 1, error, "1フレームに1体も考えないと AI が止まる"
.assert AI_RETHINK_PER_FRAME >= 1, error, "臨時の考え直しが 0 だと、標的を失った者が思考の順番まで棒立ちになる"

.endif
