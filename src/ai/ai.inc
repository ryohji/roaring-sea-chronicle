; ai.inc — 自律行動の語彙（目標ID・フラグ・プロファイル行の番号）。
;          **調整値をここに書かない**（数値は data/ai_params.tsv と ai_params.inc）。
;
; ent_ai（src/engine/entity.s）は「AI 型 ID の箱」であり、その中身を決めるのは
; ai-dev / data である。ここがその語彙の一次情報。
.ifndef AI_INC
AI_INC = 1

.include "constants.inc"

; --- プロファイル行の番号 ---
; data/ai_params.tsv の id 列がそのまま ent_ai に入る。ここにあるのは
; 「いま表に何行あるか」と、コード内で名指しが要る行だけである。
;
; 企画書 §4 の6型（突撃 / 牽制 / 回収 / 庇護 / 遠隔 / 万能）はこの表の6行になる。
; **P1 は万能1行だけ**（docs/plan.md P1）。残り5行は P2 で TSV に足す。
; 敵も同じ表の行で表す。敵専用の思考ルーチンを別に書くことは、
; 「型ごとに別コードを書き散らす」のと同じ失敗である。
AI_PROF_ALLY_VERSATILE = 0   ; 万能（自律仲間）
AI_PROF_ENEMY_MELEE    = 1   ; 近接して殴るだけの敵
AI_PROFILE_COUNT       = 2

; --- 目標（ai_goal に入る値）---
; 意思決定ループが選ぶのはこの3つだけである。行動の中身（どこに立つか・
; いつ振るか）は目標ではなくパラメータが決める。
AI_GOAL_IDLE    = 0   ; 狙う相手も戻る先も無い。その場に居る
AI_GOAL_REGROUP = 1   ; 操作キャラの側へ戻る（follow_x の位置に立つ）
AI_GOAL_ENGAGE  = 2   ; 標的と間合いを取り、届けば振る
AI_GOAL_COUNT   = 3

; --- ai_flags のビット ---
AI_F_SIDE_LEFT = %00000001   ; 立ち位置が標的の左側（0 なら右側）

; --- ai_sit のビット（状況評価の結果。1フレームに1回更新）---
; **ADR-0006 の口**。操作キャラが猶予中（ダウン中）のあいだ、プレイヤーの
; キャラクター操作は一切効かない。事態を変えられるのは自律仲間の行動だけである。
; したがって AI は「操作キャラが倒れている」を状況として知っていなければならない。
;
; **P1 では、このビットで行動を変えない。**蘇生アイテムを使う行動は P2（ADR-0007）であり、
; 「助けに行く」行動そのものも蘇生手段の設計が決まるまで実装しない（ai-dev の規約）。
; ここは認識の口を開けてあるだけである。読むのは P2 の意思決定ループ。
;
; **立つのは猶予中（ACT_ST_DOWN）だけ**である。猶予切れ（ACT_ST_OUT）では立てない。
; OUT は シナリオ失敗が確定した状態（ADR-0005）で、蘇生はもう効かないからである。
; ここを「DOWN 以上」にすると、P2 で蘇生アイテムを使う判断を書いた瞬間に
; 「失敗確定後に共有アイテムを1個捨てる」経路ができる。
AI_SIT_LEADER_DOWN = %00000001

; 標的なしを表す番号。エンティティ番号として現れない値であること。
AI_NONE = $FF
.assert AI_NONE >= MAX_ENTITIES, error, "AI_NONE が実在のエンティティ番号と衝突する"

.endif
